// This is the Prisma schema for ShuddhoBazar E-Commerce Platform
// SQLite for development, PostgreSQL-compatible for production

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================================
// USERS & AUTHENTICATION
// ============================================================

model User {
  id              String    @id @default(cuid())
  email           String?   @unique
  phone           String?   @unique
  name            String?
  password        String?
  role            UserRole  @default(CUSTOMER)
  status          UserStatus @default(ACTIVE)
  emailVerified   Boolean   @default(false)
  phoneVerified   Boolean   @default(false)
  avatar          String?
  resetToken      String?
  resetTokenExpiry DateTime?
  verifyToken     String?
  verifyTokenExpiry DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  adminProfile    AdminProfile?
  addresses       Address[]
  orders          Order[]
  cart            Cart?
  wishlist        Wishlist?
  reviews         Review[]
  couponUsages    CouponUsage[]
  notifications   Notification[]
  activityLogs    ActivityLog[]   @relation("AdminActivityLogs")
  customerNotes   CustomerNote[]

  @@index([email])
  @@index([phone])
  @@index([role])
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  MANAGER
  ORDER_MANAGER
  PRODUCT_MANAGER
  CONTENT_MANAGER
  DELIVERY_MANAGER
  SUPPORT_STAFF
  CUSTOMER
}

enum UserStatus {
  ACTIVE
  BLOCKED
  PENDING
}

model AdminProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  department  String?
  permissions String   @default("[]") // JSON array of permission strings
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CustomerNote {
  id        String   @id @default(cuid())
  userId    String
  note      String
  createdBy String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ============================================================
// CATEGORIES
// ============================================================

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  image       String?
  banner      String?
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  seoTitle    String?
  seoDesc     String?
  seoKeywords String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  subcategories SubCategory[]
  products      Product[]

  @@index([slug])
  @@index([isActive])
}

model SubCategory {
  id          String    @id @default(cuid())
  categoryId  String
  name        String
  slug        String    @unique
  description String?
  image       String?
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  seoTitle    String?
  seoDesc     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  products    Product[]

  @@index([categoryId])
  @@index([slug])
}

// ============================================================
// BRANDS
// ============================================================

model Brand {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  logo        String?
  banner      String?
  description String?
  website     String?
  isActive    Boolean   @default(true)
  seoTitle    String?
  seoDesc     String?
  seoKeywords String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  products    Product[]

  @@index([slug])
}

// ============================================================
// PRODUCTS
// ============================================================

model Product {
  id               String    @id @default(cuid())
  name             String
  slug             String    @unique
  sku              String?   @unique
  barcode          String?
  categoryId       String?
  subCategoryId    String?
  brandId          String?
  shortDesc        String?
  description      String?
  thumbnail        String?
  videoUrl         String?
  regularPrice     Float     @default(0)
  salePrice        Float?
  costPrice        Float?
  stock            Int       @default(0)
  lowStockThreshold Int      @default(5)
  weight           Float?
  unit             String?   @default("pcs")
  tags             String    @default("[]") // JSON array
  // Status flags
  isFeatured       Boolean   @default(false)
  isBestSelling    Boolean   @default(false)
  isTrending       Boolean   @default(false)
  isNewArrival     Boolean   @default(true)
  isOffer          Boolean   @default(false)
  isPreOrder       Boolean   @default(false)
  isFreeDelivery   Boolean   @default(false)
  isOrganic        Boolean   @default(false)
  isFlashSale      Boolean   @default(false)
  isPublished      Boolean   @default(false)
  // SEO
  seoTitle         String?
  seoDesc          String?
  seoKeywords      String?
  // Meta
  viewCount        Int       @default(0)
  soldCount        Int       @default(0)
  avgRating        Float     @default(0)
  reviewCount      Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  category         Category?     @relation(fields: [categoryId], references: [id])
  subCategory      SubCategory?  @relation(fields: [subCategoryId], references: [id])
  brand            Brand?        @relation(fields: [brandId], references: [id])
  images           ProductImage[]
  variants         ProductVariant[]
  attributes       ProductAttribute[]
  inventory        Inventory?
  inventoryTxns    InventoryTransaction[]
  cartItems        CartItem[]
  wishlistItems    WishlistItem[]
  orderItems       OrderItem[]
  reviews          Review[]
  comboItems       ComboItem[]
  flashSaleItems   FlashSaleItem[]

  @@index([slug])
  @@index([categoryId])
  @@index([brandId])
  @@index([isPublished])
  @@index([isFeatured])
  @@index([isNewArrival])
  @@index([isBestSelling])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String
  alt       String?
  sortOrder Int      @default(0)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductVariant {
  id          String   @id @default(cuid())
  productId   String
  name        String   // e.g. "500g", "1kg", "250ml"
  sku         String?
  price       Float?
  salePrice   Float?
  stock       Int      @default(0)
  weight      Float?
  image       String?
  sortOrder   Int      @default(0)
  isDefault   Boolean  @default(false)
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems   CartItem[]
  orderItems  OrderItem[]

  @@index([productId])
}

model ProductAttribute {
  id        String   @id @default(cuid())
  productId String
  name      String   // e.g. "Ingredients", "Nutrition"
  value     String
  sortOrder Int      @default(0)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

// ============================================================
// INVENTORY
// ============================================================

model Inventory {
  id          String    @id @default(cuid())
  productId   String    @unique
  quantity    Int       @default(0)
  reserved    Int       @default(0)
  updatedAt   DateTime  @updatedAt
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model InventoryTransaction {
  id          String            @id @default(cuid())
  productId   String
  type        InventoryTxnType
  quantity    Int
  note        String?
  reference   String?           // Order ID or manual ref
  createdBy   String?
  createdAt   DateTime          @default(now())
  product     Product           @relation(fields: [productId], references: [id])

  @@index([productId])
  @@index([type])
}

enum InventoryTxnType {
  PURCHASE
  ORDER
  RETURN
  ADJUSTMENT
  DAMAGE
}

// ============================================================
// CART
// ============================================================

model Cart {
  id          String     @id @default(cuid())
  userId      String?    @unique
  sessionId   String?    @unique
  couponId    String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  user        User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items       CartItem[]
  coupon      Coupon?    @relation(fields: [couponId], references: [id])

  @@index([sessionId])
}

model CartItem {
  id          String          @id @default(cuid())
  cartId      String
  productId   String
  variantId   String?
  quantity    Int             @default(1)
  createdAt   DateTime        @default(now())

  cart        Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product     Product         @relation(fields: [productId], references: [id])
  variant     ProductVariant? @relation(fields: [variantId], references: [id])

  @@unique([cartId, productId, variantId])
  @@index([cartId])
}

// ============================================================
// WISHLIST
// ============================================================

model Wishlist {
  id        String         @id @default(cuid())
  userId    String         @unique
  createdAt DateTime       @default(now())

  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     WishlistItem[]
}

model WishlistItem {
  id         String    @id @default(cuid())
  wishlistId String
  productId  String
  addedAt    DateTime  @default(now())

  wishlist   Wishlist  @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  product    Product   @relation(fields: [productId], references: [id])

  @@unique([wishlistId, productId])
}

// ============================================================
// ADDRESSES
// ============================================================

model Address {
  id          String    @id @default(cuid())
  userId      String
  name        String
  phone       String
  division    String
  district    String
  area        String
  fullAddress String
  isDefault   Boolean   @default(false)
  createdAt   DateTime  @default(now())

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders      Order[]

  @@index([userId])
}

// ============================================================
// DELIVERY
// ============================================================

model DeliveryZone {
  id                  String         @id @default(cuid())
  name                String
  description         String?
  isActive            Boolean        @default(true)
  createdAt           DateTime       @default(now())

  rates               DeliveryRate[]
  orders              Order[]
}

model DeliveryRate {
  id                  String       @id @default(cuid())
  zoneId              String
  name                String       // e.g. "Inside Dhaka", "Outside Dhaka"
  charge              Float
  freeThreshold       Float?       // Free delivery if order exceeds this
  estimatedDays       String?      // e.g. "1-2 days"
  isActive            Boolean      @default(true)

  zone                DeliveryZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@index([zoneId])
}

// ============================================================
// COUPONS
// ============================================================

model Coupon {
  id              String      @id @default(cuid())
  code            String      @unique
  type            CouponType
  value           Float       // Percentage or fixed amount
  minOrder        Float?
  maxDiscount     Float?
  usageLimit      Int?
  perUserLimit    Int?
  usedCount       Int         @default(0)
  isFirstOrder    Boolean     @default(false)
  isActive        Boolean     @default(true)
  startDate       DateTime?
  endDate         DateTime?
  specificProducts String     @default("[]") // JSON
  specificCategories String   @default("[]") // JSON
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  usages          CouponUsage[]
  carts           Cart[]

  @@index([code])
}

enum CouponType {
  PERCENTAGE
  FIXED
  FREE_DELIVERY
  BUY_X_GET_Y
}

model CouponUsage {
  id        String   @id @default(cuid())
  couponId  String
  userId    String
  orderId   String?
  usedAt    DateTime @default(now())

  coupon    Coupon   @relation(fields: [couponId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@index([couponId])
  @@index([userId])
}

// ============================================================
// ORDERS
// ============================================================

model Order {
  id              String       @id @default(cuid())
  orderNumber     String       @unique // SB-00001
  userId          String?
  guestName       String?
  guestEmail      String?
  guestPhone      String?
  addressId       String?
  // Snapshot of address at time of order
  shippingName    String
  shippingPhone   String
  shippingEmail   String?
  shippingDiv     String
  shippingDist    String
  shippingArea    String
  shippingAddress String
  deliveryNote    String?
  zoneId          String?
  deliveryCharge  Float        @default(0)
  subtotal        Float
  discount        Float        @default(0)
  couponDiscount  Float        @default(0)
  taxAmount       Float        @default(0)
  total           Float
  couponId        String?
  couponCode      String?
  paymentMethod   String       @default("COD")
  paymentStatus   PaymentStatus @default(PENDING)
  status          OrderStatus  @default(PENDING)
  trackingNumber  String?
  deliveryPersonId String?
  internalNote    String?
  cancelReason    String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  user            User?        @relation(fields: [userId], references: [id])
  address         Address?     @relation(fields: [addressId], references: [id])
  zone            DeliveryZone? @relation(fields: [zoneId], references: [id])
  items           OrderItem[]
  payment         Payment?
  statusHistory   OrderStatusHistory[]

  @@index([orderNumber])
  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  PACKED
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RETURNED
  REFUNDED
  FAILED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model OrderItem {
  id          String          @id @default(cuid())
  orderId     String
  productId   String
  variantId   String?
  productName String
  variantName String?
  sku         String?
  thumbnail   String?
  quantity    Int
  unitPrice   Float
  salePrice   Float?
  total       Float

  order       Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product         @relation(fields: [productId], references: [id])
  variant     ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([orderId])
}

model OrderStatusHistory {
  id        String      @id @default(cuid())
  orderId   String
  status    OrderStatus
  note      String?
  createdBy String?
  createdAt DateTime    @default(now())

  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

// ============================================================
// PAYMENTS
// ============================================================

model Payment {
  id            String        @id @default(cuid())
  orderId       String        @unique
  amount        Float
  method        String        // COD, BKASH, NAGAD, ROCKET, ONLINE
  status        PaymentStatus @default(PENDING)
  transactionId String?
  gateway       String?
  gatewayData   String?       // JSON response from payment gateway
  paidAt        DateTime?
  createdAt     DateTime      @default(now())

  order         Order         @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@index([transactionId])
}

// ============================================================
// REVIEWS
// ============================================================

model Review {
  id         String        @id @default(cuid())
  productId  String
  userId     String
  rating     Int           // 1-5
  title      String?
  body       String?
  isVerified Boolean       @default(false)
  isApproved Boolean       @default(false)
  isFeatured Boolean       @default(false)
  createdAt  DateTime      @default(now())

  product    Product       @relation(fields: [productId], references: [id])
  user       User          @relation(fields: [userId], references: [id])
  images     ReviewImage[]

  @@unique([productId, userId])
  @@index([productId])
  @@index([isApproved])
}

model ReviewImage {
  id       String @id @default(cuid())
  reviewId String
  url      String
  review   Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
}

// ============================================================
// COMBOS / BUNDLES
// ============================================================

model Combo {
  id          String      @id @default(cuid())
  name        String
  slug        String      @unique
  description String?
  image       String?
  bundlePrice Float
  isActive    Boolean     @default(true)
  sortOrder   Int         @default(0)
  seoTitle    String?
  seoDesc     String?
  createdAt   DateTime    @default(now())

  items       ComboItem[]
}

model ComboItem {
  id        String  @id @default(cuid())
  comboId   String
  productId String
  quantity  Int     @default(1)
  combo     Combo   @relation(fields: [comboId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])

  @@index([comboId])
}

// ============================================================
// FLASH SALE
// ============================================================

model FlashSale {
  id          String          @id @default(cuid())
  name        String
  banner      String?
  startTime   DateTime
  endTime     DateTime
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())

  items       FlashSaleItem[]
}

model FlashSaleItem {
  id          String    @id @default(cuid())
  flashSaleId String
  productId   String
  salePrice   Float
  stock       Int?
  soldCount   Int       @default(0)

  flashSale   FlashSale @relation(fields: [flashSaleId], references: [id], onDelete: Cascade)
  product     Product   @relation(fields: [productId], references: [id])

  @@index([flashSaleId])
}

// ============================================================
// BANNERS
// ============================================================

model Banner {
  id            String    @id @default(cuid())
  title         String?
  image         String
  mobileImage   String?
  link          String?
  heading       String?
  subheading    String?
  buttonText    String?
  buttonUrl     String?
  type          BannerType @default(HERO)
  sortOrder     Int        @default(0)
  isActive      Boolean    @default(true)
  startDate     DateTime?
  endDate       DateTime?
  createdAt     DateTime   @default(now())

  @@index([type, isActive])
}

enum BannerType {
  HERO
  PROMO
  CATEGORY
  OFFER
}

// ============================================================
// HOMEPAGE SECTIONS
// ============================================================

model HomepageSection {
  id             String   @id @default(cuid())
  type           String   // HERO, CATEGORIES, FLASH_SALE, TOP_SELLERS, NEW_ARRIVALS, etc.
  heading        String?
  subheading     String?
  productSource  String?  // FEATURED, BEST_SELLING, NEW_ARRIVAL, CATEGORY, MANUAL
  categoryId     String?
  productCount   Int      @default(8)
  backgroundClr  String?
  ctaText        String?
  ctaUrl         String?
  showOnMobile   Boolean  @default(true)
  showOnDesktop  Boolean  @default(true)
  sortOrder      Int      @default(0)
  isActive       Boolean  @default(true)
  config         String   @default("{}") // JSON for extra config
  updatedAt      DateTime @updatedAt
}

// ============================================================
// BLOG
// ============================================================

model BlogCategory {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  blogs     Blog[]
}

model Blog {
  id           String        @id @default(cuid())
  title        String
  slug         String        @unique
  excerpt      String?
  content      String
  featuredImage String?
  categoryId   String?
  authorId     String?
  authorName   String?
  tags         String        @default("[]") // JSON
  type         BlogType      @default(BLOG)
  seoTitle     String?
  seoDesc      String?
  publishedAt  DateTime?
  isPublished  Boolean       @default(false)
  viewCount    Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  category     BlogCategory? @relation(fields: [categoryId], references: [id])

  @@index([slug])
  @@index([isPublished])
}

enum BlogType {
  BLOG
  STORY
  RECIPE
  FOOD_GUIDE
  NEWS
}

// ============================================================
// CMS PAGES
// ============================================================

model Page {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  content     String
  seoTitle    String?
  seoDesc     String?
  isPublished Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([slug])
}

// ============================================================
// MENUS
// ============================================================

model Menu {
  id        String     @id @default(cuid())
  name      String
  location  String     @unique // HEADER, FOOTER, MOBILE
  items     MenuItem[]
}

model MenuItem {
  id        String    @id @default(cuid())
  menuId    String
  parentId  String?
  label     String
  type      MenuItemType @default(CUSTOM)
  url       String?
  reference String?   // Category/product/brand/page ID
  sortOrder Int       @default(0)
  isActive  Boolean   @default(true)

  menu      Menu      @relation(fields: [menuId], references: [id], onDelete: Cascade)
  parent    MenuItem? @relation("MenuItemChildren", fields: [parentId], references: [id])
  children  MenuItem[] @relation("MenuItemChildren")

  @@index([menuId])
}

enum MenuItemType {
  PAGE
  CATEGORY
  PRODUCT
  BRAND
  CUSTOM
}

// ============================================================
// MEDIA LIBRARY
// ============================================================

model Media {
  id          String    @id @default(cuid())
  filename    String
  originalName String
  url         String
  size        Int
  mimeType    String
  folder      String    @default("general")
  alt         String?
  uploadedBy  String?
  createdAt   DateTime  @default(now())

  @@index([folder])
}

// ============================================================
// NOTIFICATIONS
// ============================================================

model Notification {
  id        String             @id @default(cuid())
  userId    String?
  type      NotificationType
  title     String
  message   String
  link      String?
  isRead    Boolean            @default(false)
  data      String?            // JSON
  createdAt DateTime           @default(now())

  user      User?              @relation(fields: [userId], references: [id])

  @@index([userId, isRead])
}

enum NotificationType {
  ORDER_PLACED
  ORDER_CONFIRMED
  ORDER_SHIPPED
  ORDER_DELIVERED
  ORDER_CANCELLED
  LOW_STOCK
  NEW_CUSTOMER
  NEW_REVIEW
  PAYMENT_RECEIVED
  SYSTEM
}

// ============================================================
// EMAIL TEMPLATES
// ============================================================

model EmailTemplate {
  id        String   @id @default(cuid())
  key       String   @unique // ORDER_CONFIRMATION, WELCOME, etc.
  subject   String
  body      String
  isActive  Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

// ============================================================
// SETTINGS
// ============================================================

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  group     String   @default("general")
  updatedAt DateTime @updatedAt

  @@index([group])
}

// ============================================================
// TAX
// ============================================================

model Tax {
  id          String   @id @default(cuid())
  name        String
  percentage  Float
  isInclusive Boolean  @default(false) // Tax included in price
  isActive    Boolean  @default(true)
  applyTo     String   @default("ALL") // ALL, CATEGORY:id, PRODUCT:id
  createdAt   DateTime @default(now())
}

// ============================================================
// ACTIVITY LOGS
// ============================================================

model ActivityLog {
  id         String   @id @default(cuid())
  adminId    String?
  action     String
  target     String?
  targetId   String?
  details    String?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  admin      User?    @relation("AdminActivityLogs", fields: [adminId], references: [id])

  @@index([adminId])
  @@index([action])
  @@index([createdAt])
}

// ============================================================
// INCOMPLETE ORDERS / ABANDONED CHECKOUTS
// ============================================================

model IncompleteOrder {
  id               String    @id @default(cuid())
  sessionId        String?   @unique
  userId           String?
  customerName     String?
  phone            String?
  email            String?
  division         String?
  district         String?
  area             String?
  address          String?
  deliveryNote     String?
  paymentMethod    String?   @default("COD")
  couponCode       String?
  subtotal         Float     @default(0)
  deliveryCharge   Float     @default(0)
  discount         Float     @default(0)
  total            Float     @default(0)
  items            String    @default("[]") // JSON string of cart items
  status           String    @default("NOT_CONTACTED") // NOT_CONTACTED, CONTACTED, RECOVERED, CANCELLED
  adminNote        String?
  convertedOrderId String?
  lastStep         String    @default("CHECKOUT_VIEWED")
  ipAddress        String?
  userAgent        String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([phone])
  @@index([status])
  @@index([createdAt])
}

